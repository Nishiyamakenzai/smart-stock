# ────────────────────────────────────────────────────────
# MQ会計ダッシュボード 環境変数設定
# このファイルをコピーして .env.local を作成してください
# .env.local は .gitignore に含まれているため安全です
# ────────────────────────────────────────────────────────

# Supabase プロジェクト URL
# 取得場所: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Service Role Key（サーバーサイド専用・絶対に公開しない）
# 取得場所: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT署名シークレット（ランダムな64文字の文字列）
# 生成コマンド: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your-64-char-random-hex-string-here

# パスワードリセット用マスターキー（忘れた時のみ使用）
# 生成コマンド: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Vercelダッシュボードの Environment Variables に設定し、このキーは安全な場所に保管してください
RESET_SECRET=your-reset-secret-key-here
